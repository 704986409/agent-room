{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Room",
  "version": "0.1.20",
  "identifier": "com.agent-room.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../daemon-dist/": "daemon/",
      "../node-runtime/": "node/",
      "../mcp-runtime/": "mcp/"
    },
    "category": "Productivity",
    "shortDescription": "Agent Room desktop client",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
