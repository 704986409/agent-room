{
  "name": "@agent-room/memory",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:postgres": "node dist/migrate.js",
    "model:download": "node scripts/download-embedding-model.mjs",
    "backfill:embeddings": "node dist/backfill-embeddings.js",
    "benchmark:search": "npm run build && node scripts/benchmark-search.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
