#!/usr/bin/env node
// MOCK codex CLI (no model). Emits codex --json thread.started, then follows the
// daemon prompt via hosted MCP using the seatKey from AGENT_ROOM_SEAT_KEY.
const fs = require('fs'); const { createRequire } = require('module'); const { randomUUID } = require('crypto');
const r = createRequire('/home/box/MERYANG/agent-room-desktop/package.json');
const log = m => fs.appendFileSync('/home/box/MERYANG/localtest/mock-codex2.log', `${new Date().toISOString()} ${m}\n`);
if (process.argv.includes('--version')) { console.log('codex-cli 0.0.0-mock'); process.exit(0); }
(async () => {
  const args = process.argv.slice(2); const prompt = args[args.length - 1] || '';
  const resumeAt = args.indexOf('resume'); const thread = resumeAt >= 0 ? args[resumeAt + 1] : '01a1mock-' + randomUUID().slice(0, 8);
  console.log(JSON.stringify({ type: 'thread.started', thread_id: thread }));
  const key = process.env.AGENT_ROOM_SEAT_KEY || '';
  log(`argv=${JSON.stringify(args.slice(0, -1))} managed=${process.env.AGENT_ROOM_MANAGED} seatKeyEnv=${key ? 'yes' : 'no'} promptHasKey=${key && prompt.includes(key)}`);
  const m = /room_listen\(\{ code: "([^"]+)", name: "([^"]+)", since: (\d+)/.exec(prompt);
  if (!m) return;
  const [, code, name, since] = m; const server = process.env.AGENT_ROOM_SERVER || 'http://127.0.0.1:3300';
  const { Client } = await import(r.resolve('@modelcontextprotocol/sdk/client/index.js'));
  const { StreamableHTTPClientTransport } = await import(r.resolve('@modelcontextprotocol/sdk/client/streamableHttp.js'));
  const c = new Client({ name: 'mock-codex', version: '0' }); await c.connect(new StreamableHTTPClientTransport(new URL(server + '/mcp')));
  const pj = v => JSON.parse(v.content[0].text);
  const read = pj(await c.callTool({ name: 'room_listen', arguments: { code, name, since: Number(since), timeoutMs: 0, managed: { seatKey: key } } }));
  log(`read since=${since} got=${read.messages?.length} cursor=${read.cursor} err=${read.error ?? ''}`);
  const first = resumeAt < 0;
  await c.callTool({ name: 'room_send', arguments: { code, name, seatKey: key, text: first ? `mock agent: online (${thread})` : `mock agent: done (${thread})` } });
  const sl = pj(await c.callTool({ name: 'room_sleep', arguments: { code, name, seatKey: key, cursor: read.cursor + 1 } }));
  log(`sleep ${JSON.stringify(sl)}`); await c.close();
})().catch(e => { log('ERR ' + e.stack); process.exit(1); });
